PORT=5000
NODE_ENV=development
ATLAS_URL=mongodb+srv://<username>:<password>@<cluster-host>/?appName=<app-name>
DNS_SERVER=8.8.8.8
FRONTEND_URL=http://localhost:3000
# Extra allowed CORS origins, comma-separated (beta/preview deployments)
CORS_ORIGINS=
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id_here

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_CLOUDFRONT_DOMAIN=https://your_cloudfront_domain.cloudfront.net

# SMTP Configuration (invitation emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="LGPSM Invitations" <no-reply@example.com>

# WhatsApp Cloud API (invitation delivery)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_API_VERSION=v25.0
WHATSAPP_INVITATION_TEMPLATE=lgpsm_event_invitation
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Razorpay (ticket payments) - payments are refused while these are unset
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Google Stitch (AI template generation). Server-side only; the feature reports "unavailable" while the key is unset.
STITCH_API_KEY=your_stitch_api_key
# STITCH_TIMEOUT_MS=120000
# STITCH_DAILY_QUOTA_PER_USER=15
# STITCH_MAX_CONCURRENT_JOBS=2
