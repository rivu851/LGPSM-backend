PORT=5000
NODE_ENV=development
ATLAS_URL=mongodb+srv://<username>:<password>@<cluster-host>/?appName=<app-name>
DNS_SERVER=8.8.8.8
FRONTEND_URL=http://localhost:3000
# Extra allowed CORS origins, comma-separated (beta/preview deployments)
CORS_ORIGINS=
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id_here

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_CLOUDFRONT_DOMAIN=https://your_cloudfront_domain.cloudfront.net
# For CDN delivery, set this to the absolute path of media.eventqrapp.com's document root,
# and make sure the backend process can write to that same shared folder.
MEDIA_DIR=
# Set this only when MEDIA_DIR points to the document root served by this address.
MEDIA_PUBLIC_URL=
# MEDIA_PUBLIC_URL=https://media.eventqrapp.com

# SMTP Configuration (invitation emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# Optional: send mail without attachments over Brevo's HTTPS API (use where SMTP ports are blocked)
BREVO_API_KEY=
BREVO_SENDER=
SMTP_FROM="LGPSM Invitations" <no-reply@example.com>

# WhatsApp Cloud API (invitation delivery)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_API_VERSION=v25.0
WHATSAPP_INVITATION_TEMPLATE=lgpsm_event_invitation
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Razorpay (ticket payments) - payments are refused while these are unset
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Google Stitch (AI template generation). Server-side only; the feature reports "unavailable" while the key is unset.
STITCH_API_KEY=your_stitch_api_key
# STITCH_TIMEOUT_MS=120000
# STITCH_DAILY_QUOTA_PER_USER=15
# STITCH_MAX_CONCURRENT_JOBS=2

# Access-pass secrets and links
# Key that encrypts the stored copy of each guest's tokens. Set it to its own long random value in staging and production: when unset the key is
# derived from JWT_SECRET, so rotating JWT_SECRET would make every stored copy unreadable. Never change it once guests have been invited.
QR_TOKEN_SECRET=
# Where invitation links point (defaults to FRONTEND_URL/invitation)
INVITATION_BASE_URL=
# Approved WhatsApp templates for event-cancellation and access-pass messages. While unset, those WhatsApp messages are reported as unavailable (email is unaffected).
WHATSAPP_CANCELLATION_TEMPLATE=
WHATSAPP_REPLACEMENT_TEMPLATE=
WHATSAPP_REVOCATION_TEMPLATE=
# Platform time zone used in messages and cards (default Asia/Kolkata)
APP_TIMEZONE=


# --- Cache, rate-limit counters and request guards (optional) ---
# Without these the app keeps them in the server's own memory (correct for ONE server process). To use real Redis, create an Upstash Redis
# database (it is reached over HTTPS, so it works from shared Node hosting) and set both values; nothing else changes. If Redis is
# unreachable the app falls back to memory by itself.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token
# Prefix on every key, so development and production can share one database without touching each other's data
# KV_PREFIX=eqr:prod:

# --- Printable invitation cards (optional) ---
# Cards are built in the background as ONE zip. These tune it for the server it runs on.
# Most guests in one smaller zip (1 to 100). Lower it on a slow server: each smaller zip is then quicker to prepare.
# CARD_ZIP_MAX_GUESTS=100
# Most people whose cards can be prepared at the same moment (default 2)
# CARD_JOBS_MAX=2
# Where the cards are assembled before they are downloaded (default: the system temp folder). Needs room for the finished zip.
# CARD_TMP_DIR=/tmp/eqr-cards
